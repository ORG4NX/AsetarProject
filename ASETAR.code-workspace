{
  "folders": [
    {
      "name": "ASETAR",
      "path": "."
    }
  ],
  "settings": {
    "task.allowAutomaticTasks": "on"
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Claude Code",
        "type": "shell",
        "command": "claude",
        "options": {
          "cwd": "${workspaceFolder}"
        },
        "isBackground": true,
        "problemMatcher": [],
        "presentation": {
          "reveal": "always",
          "focus": true,
          "panel": "dedicated",
          "showReuseMessage": false,
          "clear": true
        },
        "runOptions": {
          "runOn": "folderOpen"
        }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "anthropic.claude-code"
    ]
  }
}
