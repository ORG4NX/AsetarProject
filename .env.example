# Copier ce fichier en .env puis remplir les valeurs (.env n'est pas versionné).

# Mot de passe de l'utilisateur MariaDB « asetar » (base ASETAR08).
# Pris en compte uniquement à la création du volume asetar_db : le changer ensuite
# demande de le modifier aussi dans MariaDB (ou de recréer le volume).
ASETAR_DB_PASSWORD=change-moi
